{ "transform": "toggle",
  "cases": [
    { "name": "flips on each event",
      "steps": [
        { "event": "press", "expect": true, "expectEvents": ["on"] },
        { "event": "press", "expect": false, "expectEvents": ["off"] },
        { "input": 3, "expect": false, "expectEvents": [] } ] },
    { "name": "starts from initial",
      "options": { "initial": true },
      "steps": [ { "event": "press", "expect": false } ] }
  ] }
