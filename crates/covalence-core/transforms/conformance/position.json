{ "transform": "position",
  "cases": [
    { "name": "follows detents and clamps",
      "options": { "min": 0, "max": 10 },
      "steps": [
        { "input": 0, "expect": 0 },
        { "input": 3, "expect": 3, "expectEvents": ["change"] },
        { "input": 20, "expect": 10 },
        { "input": 18, "expect": 8 },
        { "event": "press", "expect": 8, "expectEvents": [] } ] },
    { "name": "steps, accelerates and wraps",
      "options": { "min": 0, "max": 1, "step": 0.1, "accel": 0.5, "wrap": true },
      "steps": [
        { "input": 0 },
        { "input": 1 },
        { "input": 4 },
        { "input": 1 },
        { "input": -10 } ] },
    { "name": "a smaller max clamps at the next step",
      "options": { "max": 100, "initial": 50 },
      "steps": [
        { "input": 0 },
        { "options": { "max": 20 }, "input": 1, "expect": 20 } ] }
  ] }
