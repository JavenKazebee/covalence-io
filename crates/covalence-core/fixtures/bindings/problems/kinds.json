{
  "binding": {
    "control": "k6",
    "props": {
      "background": { "use": "template", "parts": ["#ff", "0000"] },
      "label": { "expr": "vars.name +" },
      "textColor": {
        "use": "map",
        "input": { "ref": { "root": "vars", "path": ["level"] } },
        "from": [0, 1],
        "to": []
      }
    }
  },
  "errors": [
    { "path": ["props", "background", "use"], "code": "badValue" },
    { "path": ["props", "label", "expr"], "code": "exprSyntax" },
    { "path": ["props", "textColor", "to"], "code": "badValue" }
  ]
}
