{
  "exclude": [
    "packages/ui/"
  ],
  "workspace": [
    "./packages/protocol",
    "./packages/sdk",
    "./packages/plugin-host",
    "./plugins/videohub"
  ],
  "fmt": {
    "include": [
      "packages/",
      "plugins/"
    ],
    "exclude": [
      "**/*.gen.ts"
    ]
  },
  "lint": {
    "include": [
      "packages/",
      "plugins/"
    ],
    "exclude": [
      "**/*.gen.ts"
    ]
  },
  "test": {
    "include": [
      "packages/",
      "plugins/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/msgpack": "jsr:@std/msgpack@^1.0.3",
    "ajv": "npm:ajv@8.20.0",
    "ajv/": "npm:/ajv@8.20.0/"
  },
  "nodeModulesDir": "none",
  "tasks": {
    "test": "deno test --allow-read=. --allow-env --allow-write=protocol/fixtures/encoded --allow-net=127.0.0.1 --allow-run=deno"
  }
}
